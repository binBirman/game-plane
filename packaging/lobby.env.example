LOBBY_BIND=0.0.0.0:8192
LOBBY_DATABASE_URL=sqlite:///var/lib/lobby/lobby.db?mode=rwc
LOBBY_SESSION_TTL_DAYS=7

# Public-facing host:port used in `ws_url` returned to clients.
# Defaults to bind address. Set differently if reverse-proxied.
# LOBBY_PUBLIC_HOST=127.0.0.1
# LOBBY_PUBLIC_PORT=8192

# Game registry. Defaults to a single in-process registration pointing
# at LOBBY_GAME_BIN. Override to /etc/lobby/games.toml for multi-game.
# LOBBY_GAMES_TOML=/etc/lobby/games.toml
LOBBY_GAME_BIN=/usr/local/bin/tictactoe

# Logging
LOBBY_LOG_FORMAT=json
LOBBY_LOG_FILE_DIR=/var/log/lobby
LOBBY_LOG_KEEP_DAYS=14

# Rate limits (per client IP, sliding 60-second window).
LOBBY_RL_REGISTER_PER_MIN=10
LOBBY_RL_LOGIN_PER_MIN=20
LOBBY_RL_CAPTCHA_PER_MIN=60

# tracing-subscriber filter (env-filter syntax).
# Default: INFO+ globally, DEBUG for HTTP, DEBUG for the plain-text
# game-stderr fallback (lobby::game_stderr). Structured game logs
# emitted via `game_sdk::game_log!` carry their own level and target
# so they show up at INFO+ by default.
#
# Useful patterns:
#   RUST_LOG=info,lobby::http=debug                # default
#   RUST_LOG=debug                                 # everything
#   RUST_LOG=info,lobby::http=debug,lobby::game_stderr=debug  # also see plain-text stderr
#   RUST_LOG=info,take_your_position=debug        # game crate DEBUG for everything underneath
RUST_LOG=info,lobby::http=debug,lobby::game_stderr=debug